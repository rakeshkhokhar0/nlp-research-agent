# =============================================================================
# NLP Research Agent - Root .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (Never commit credentials or local configs)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc

# Explicitly keep example environment templates
!.env.example
!*.env.example
!**/.env.example

# -----------------------------------------------------------------------------
# Python / FastAPI Backend
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/*
!.pixi/config.toml
__pypackages__/

# Pytest & testing / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover
*.py.cover
nosetests.xml

# Static analysis & Linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# -----------------------------------------------------------------------------
# Node.js / React Frontend
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# Build outputs
dist-ssr/

# Frontend caches & tooling
.vite/
.eslintcache
.parcel-cache
.cache/

# Frontend test coverage
coverage/
.nyc_output/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Databases, Logs & Temporary Storage
# -----------------------------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
*.rdb
*.aof
*.pid
instance/
tmp/
temp/

# -----------------------------------------------------------------------------
# IDEs & Code Editors
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
tempCodeRunnerFile.py

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml

# Vim / Emacs / Sublime / Eclipse
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
.directory
