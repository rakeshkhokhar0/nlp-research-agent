# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/nlp_research
TEST_DB_URL=postgresql+asyncpg://username:password@localhost:5432/nlp_research_test

# Cloudinary PDF Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_SECURE=True

# OpenAI LLM Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Logging & Tracing Configuration (Optional)
LOG_LEVEL=INFO
NLP_TRACE_ENABLED=False
NLP_TRACE_CONTENT_PREVIEW=False
LLM_TRACE_ENABLED=False
LLM_TRACE_FULL_CONTENT=False
